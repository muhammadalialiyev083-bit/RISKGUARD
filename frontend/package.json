{
  "name": "bcms-designer-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/auth.cjs && node tests/domain.e2e.cjs && node tests/e2e/operations.cjs",
    "test:reports": "node tests/e2e/reporting.cjs",
    "test:map": "node tests/e2e/map.cjs",
    "design:tokens": "node ../.agents/skills/design-system/scripts/generate-tokens.cjs --config design-tokens.json -o src/styles/tokens.css"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
